{
  "name": "brickbreaker-demolition",
  "productName": "Wrecking Yard",
  "version": "4.4.0",
  "description": "Wrecking Yard - a 3D demolition and crushing game",
  "main": "electron/main.js",
  "author": "Wrecking Yard",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "exe": "node scripts/build.mjs && electron-builder --win portable --x64",
    "apk": "node scripts/build.mjs && bash scripts/build-apk.sh",
    "art": "node scripts/build.mjs && node scripts/thumbs.cjs && node scripts/build.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "resedit": "^2.0.3",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.wreckingyard.game",
    "productName": "Wrecking Yard",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "WreckingYard-${version}-Windows.exe"
    },
    "compression": "maximum",
    "afterPack": "scripts/afterPack.cjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}