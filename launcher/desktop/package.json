{
  "name": "wrecking-yard-launcher",
  "productName": "Wrecking Yard",
  "version": "1.0.0",
  "description": "Launcher for Wrecking Yard: checks for updates, downloads any game version and starts it.",
  "main": "main.js",
  "author": "Wrecking Yard",
  "license": "MIT",
  "scripts": {
    "ui": "node -e \"const fs=require('fs');fs.rmSync('ui',{recursive:true,force:true});fs.cpSync('../ui','ui',{recursive:true});fs.copyFileSync('../../public/img/logo.png','ui/logo.png');fs.copyFileSync('../../electron/icon.png','icon.png')\"",
    "start": "npm run ui && electron .",
    "dist": "npm run ui && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wreckingyard.launcher",
    "productName": "Wrecking Yard",
    "electronVersion": "33.2.0",
    "files": [
      "main.js",
      "preload.js",
      "unzip.js",
      "ui/**",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "artifactName": "WreckingYard-Launcher-Windows.${ext}"
    },
    "portable": {
      "artifactName": "WreckingYard-Launcher-Windows.exe"
    }
  }
}
